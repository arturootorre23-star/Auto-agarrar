-- Función para crear Botones / Toggles Estilo Astro
local function createToggle(name, callback)
     জিনি = Instance.new("TextButton")
    genini.Name = name
    genini.Parent = Container
    genini.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
    genini.Size = UDim2.new(1, 0, 0, 40)
    genini.Font = Enum.Font.GothamSemibold
    genini.Text = "  " .. name
    genini.TextColor3 = Color3.fromRGB(240, 240, 255)
    genini.TextSize = 13
    genini.TextXAlignment = Enum.TextXAlignment.Left
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = genini
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 50, 100)
    stroke.Parent = genini
    
    local status = Instance.new("TextLabel")
    status.Parent = genini
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(1, -70, 0, 0)
    status.Size = UDim2.new(0, 60, 1, 0)
    status.Font = Enum.Font.GothamBold
    status.Text = "[ OFF ]"
    status.TextColor3 = Color3.fromRGB(255, 80, 80)
    status.TextSize = 12
    
    local active = false
    genini.MouseButton1Click:Connect(function()
        active = not active
        if active then
            status.Text = "[ ON ]"
            status.TextColor3 = Color3.fromRGB(80, 255, 120)
            stroke.Color = Color3.fromRGB(100, 255, 150)
        else
            status.Text = "[ OFF ]"
            status.TextColor3 = Color3.fromRGB(255, 80, 80)
            stroke.Color = Color3.fromRGB(60, 50, 100)
        end
        if callback then callback(active) end
    end)
end

