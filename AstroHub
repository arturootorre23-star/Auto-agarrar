-- Función para crear Toggles Estilo Original con diseño exacto
local function createToggleRow(name, settingKey)
    local Row = Instance.new("Frame")
    Row.Parent = OptionsContainer
    Row.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    Row.Size = UDim2.new(1, -10, 0, 32)
    Row.Position = UDim2.new(0, 5, 0, 0)

    local RCorn = Instance.new("UICorner")
    RCorn.CornerRadius = UDim.new(0, 6)
    RCorn.Parent = Row

    local Label = Instance.new("TextLabel")
    Label.Parent = Row
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Size = UDim2.new(0.6, 0, 1, 0)
    Label.Font = Enum.Font.GothamSemibold
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(230, 230, 240)
    Label.TextSize = 11
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Parent = Row
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    ToggleBtn.Position = UDim2.new(1, -65, 0.15, 0)
    ToggleBtn.Size = UDim2.new(0, 55, 0, 22)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.Text = "OFF"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    ToggleBtn.TextSize = 11

    local TBtnCorn = Instance.new("UICorner")
    TBtnCorn.CornerRadius = UDim.new(0, 4)
    TBtnCorn.Parent = ToggleBtn

    ToggleBtn.MouseButton1Click:Connect(function()
        AstroSettings[settingKey] = not AstroSettings[settingKey]
        if AstroSettings[settingKey] then
            ToggleBtn.Text = "ON"
            ToggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 50)
        else
            ToggleBtn.Text = "OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        end
    end)
end

