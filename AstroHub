-- Función avanzada para crear los botones de control interactivos
local function createAdvancedButton(text, configKey, description)
    local ButtonContainer = Instance.new("Frame")
    ButtonContainer.Parent = ScrollingContainer
    ButtonContainer.BackgroundColor3 = Color3.fromRGB(20, 30, 42)
    ButtonContainer.Size = UDim2.new(1, 0, 0, 50)

    local BCorn = Instance.new("UICorner")
    BCorn.CornerRadius = UDim.new(0, 8)
    BCorn.Parent = ButtonContainer

    local BStroke = Instance.new("UIStroke")
    BStroke.Color = Color3.fromRGB(40, 70, 90)
    BStroke.Parent = ButtonContainer

    local BtnText = Instance.new("TextButton")
    BtnText.Parent = ButtonContainer
    BtnText.BackgroundTransparency = 1
    BtnText.Size = UDim2.new(1, 0, 1, 0)
    BtnText.Font = Enum.Font.GothamSemibold
    BtnText.Text = "   " .. text
    BtnText.TextColor3 = Color3.fromRGB(220, 240, 230)
    BtnText.TextSize = 13
    BtnText.TextXAlignment = Enum.TextXAlignment.Left

    local StatusIndicator = Instance.new("TextLabel")
    StatusIndicator.Parent = ButtonContainer
    StatusIndicator.BackgroundTransparency = 1
    StatusIndicator.Position = UDim2.new(1, -90, 0, 0)
    StatusIndicator.Size = UDim2.new(0, 80, 1, 0)
    StatusIndicator.Font = Enum.Font.GothamBold
    StatusIndicator.Text = "[ OFF ]"
    StatusIndicator.TextColor3 = Color3.fromRGB(255, 90, 90)
    StatusIndicator.TextSize = 12

    BtnText.MouseButton1Click:Connect(function()
        _astroConfig[configKey] = not _astroConfig[configKey]
        if _astroConfig[configKey] then
            StatusIndicator.Text = "[ ACTIVE ]"
            StatusIndicator.TextColor3 = Color3.fromRGB(0, 255, 128)
            BStroke.Color = Color3.fromRGB(0, 255, 128)
        else
            StatusIndicator.Text = "[ OFF ]"
            StatusIndicator.TextColor3 = Color3.fromRGB(255, 90, 90)
            BStroke.Color = Color3.fromRGB(40, 70, 90)
        end
    end)
end

