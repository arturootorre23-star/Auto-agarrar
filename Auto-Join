-- 3. Enviar Alerta a Discord
local function sendDiscordAlert(brainrotName, value, tier)
    if DISCORD_WEBHOOK_URL == "" or DISCORD_WEBHOOK_URL:find("TU_WEBHOOK") then return end
    
    local payload = {
        content = "@everyone 🚨 **¡SECRET DETECTADO!**",
        embeds = {{
            title = "🧠 Brainrot Raro Encontrado",
            color = 16711680,
            fields = {
                {name = "Nombre", value = tostring(brainrotName), inline = true},
                {name = "Valor", value = tostring(value), inline = true},
                {name = "Tier", value = tostring(tier), inline = true},
                {name = "Server ID (JobId)", value = "```" .. tostring(currentJobId) .. "```", inline = false}
            },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }
    
    pcall(function()
        HttpService:PostAsync(DISCORD_WEBHOOK_URL, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
    end)
end

-- 4. Botón JOIN / Copiar ID
joinButton.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(currentJobId)
        joinButton.Text = "¡JobId Copiado!"
        task.wait(2)
        joinButton.Text = "🔗 Copiar Server ID / JobId"
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, currentJobId, player)
    end
end)

-- 5. Cuando detecta el Brainrot raro, actualiza el panel y suena
local function triggerAlert(brainrotName, value, tier)
    titleLabel.Text = "✅ " .. tostring(brainrotName)
    detailsLabel.Text = string.format(
        "💰 Value: %s\n🏷️ Tier: %s\n📊 Type: Combo\n🆔 Server ID:\n%s",
        tostring(value),
        tostring(tier),
        tostring(currentJobId)
    )
    
    -- Reproducir Sonido
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://9114223207"
        sound.Volume = 1
        sound.Parent = playerGui
        sound:Play()
        sound.Ended:Connect(function() sound:Destroy() end)
    end)

    -- Mandar webhook a Discord
    sendDiscordAlert(brainrotName, value, tier)
end

-- 6. Detección en el Workspace
local function checkObject(obj)
    if rareBrainrots[obj.Name] then
        local val = obj:GetAttribute("Value") or "$1B/s"
        local tier = obj:GetAttribute("Tier") or "SECRET"
        triggerAlert(obj.Name, val, tier)
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    checkObject(obj)
end

Workspace.DescendantAdded:Connect(function(obj)
    task.wait()
    checkObject(obj)
end)

-- 7. Sistema de Bots (Si es bot, escanea, avisa y cambia de servidor)
if player:GetAttribute("IsBot") == true then
    task.spawn(function()
        task.wait(20)
        player:Kick("Cambiando de servidor...")
    end)
end

