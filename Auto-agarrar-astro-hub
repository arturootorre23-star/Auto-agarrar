-- 2. Función perfeccionada para buscar específicamente ProximityPrompts con la acción "Robar"
local function scanRobarPrompt()  
    local closestPrompt = nil  
    local shortestDistance = math.huge  
    local character = localPlayer.Character  
      
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end  
    local rootPos = character.HumanoidRootPart.Position  
  
    for _, obj in ipairs(workspace:GetDescendants()) do  
        if obj:IsA("ProximityPrompt") then  
            -- Filtramos estrictamente por la acción de robar del juego  
            if string.lower(obj.ActionText) == "robar" then  
                local parentPart = obj.Parent  
                if parentPart and (parentPart:IsA("BasePart") or parentPart:IsA("Model")) then  
                    local targetPos = parentPart:IsA("Model") and parentPart:GetPivot().Position or parentPart.Position  
                    local dist = (rootPos - targetPos).Magnitude  
                      
                    if dist < shortestDistance and dist <= (obj.MaxActivationDistance + 12) then  
                        shortestDistance = dist  
                        closestPrompt = obj  
                    end  
                end  
            end  
        end  
    end  
    return closestPrompt  
end  
  
-- 3. Bucle principal con barra fluida, detección real y autorrobo instantáneo (< 1 segundo)
task.spawn(function()  
    while true do  
        local targetPrompt = scanRobarPrompt()  
          
        if targetPrompt then  
            -- Extraemos el nombre de la base o el objeto del brainrot de forma limpia
            local baseName = "Base"  
            if targetPrompt.Parent and targetPrompt.Parent.Parent then  
                baseName = targetPrompt.Parent.Parent.Name  
            end  
              
            titleLabel.Text = baseName  
            statusLabel.Text = "Robando"  
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100) -- Cambia a verde mientras roba  
  
            -- Cuenta progresiva rápida y fluida para asegurar la captura en menos de un segundo  
            local interrupted = false  
            for i = 1, 100, 15 do  
                local currentCharacter = localPlayer.Character  
                if not currentCharacter or not currentCharacter:FindFirstChild("HumanoidRootPart") or not targetPrompt.Parent then  
                    interrupted = true  
                    break  
                end  
                  
                percentLabel.Text = i .. "%"  
                progressBar.Size = UDim2.new(i / 100, 0, 1, 0)  
                task.wait(0.04)  
            end  
  
            -- Al completarse al 100%, ejecuta el ProximityPrompt de forma totalmente automática  
            if not interrupted then  
                pcall(function()  
                    fireproximityprompt(targetPrompt)  
                end)  
                  
                percentLabel.Text = "100%"  
                progressBar.Size = UDim2.new(1, 0, 1, 0)  
                statusLabel.Text = "Paused"  
                statusLabel.TextColor3 = Color3.fromRGB(255, 220, 0) -- Regresa a amarillo de pausa como el video  
                task.wait(0.6)  
            else  
                statusLabel.Text = "Paused"  
                statusLabel.TextColor3 = Color3.fromRGB(255, 220, 0)  
            end  
        else  
            -- Si no hay objetivos cercanos, mantiene el panel activo en modo búsqueda/pausa  
            titleLabel.Text = "Buscando base..."  
            statusLabel.Text = "Paused"  
            statusLabel.TextColor3 = Color3.fromRGB(255, 220, 0)  
            progressBar.Size = UDim2.new(0, 0, 1, 0)  
            percentLabel.Text = "0%"  
        end  
  
        task.wait(0.2)  
    end  
end)
