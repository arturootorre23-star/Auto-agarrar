-- 2. Función para buscar únicamente objetos con Prompt de "Robar"
local function scanStealPrompt()
    local closestPrompt = nil
    local shortestDistance = math.huge
    local localCharacter = localPlayers.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return nil end
    local localRootPos = localCharacter.HumanoidRootPart.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            -- Verificamos si la acción se llama explícitamente "Robar"
            if obj.ActionText == "Robar" then
                local parentModel = obj.Parent
                if parentModel and parentModel:IsA("BasePart") then
                    local dist = (localRootPos - parentModel.Position).Magnitude
                    if dist < shortestDistance and dist <= obj.MaxActivationDistance then
                        shortestDistance = dist
                        closestPrompt = obj
                    end
                end
            end
        end
    end
    return closestPrompt
end

-- 3. Bucle principal con temporizador dinámico sincronizado a la barra
task.spawn(function()
    while true do
        local targetPrompt = scanStealPrompt()
        
        if targetPrompt then
            -- Configuramos una duración de barra fluida (ej. 1.5 segundos o el HoldDuration real)
            local holdTime = targetPrompt.HoldDuration > 0 and targetPrompt.HoldDuration or 1.5
            local localInterrupted = false
            
            -- Anima la barra del 0 al 100% de forma fluida
            for i = 1, 100 do
                -- Verificamos si el jugador se alejó o el objeto desapareció
                local currentCharacter = localPlayers.Character
                if not currentCharacter or not currentCharacter:FindFirstChild("HumanoidRootPart") or not targetPrompt.Parent then
                    localInterrupted = true
                    break
                end
                
                percentLabel.Text = i .. "%"
                progressBar.Size = UDim2.new(i / 100, 0, 1, 0)
                titleLabel.Text = "Robando Brainrot..."
                
                task.wait(holdTime / 100)
            end
            
            -- Al completarse los 100%, dispara el prompt al instante
            if not localInterrupted then
                pcall(function()
                    fireproximityprompt(targetPrompt)
                end)
                titleLabel.Text = "¡Brainrot Robado con Éxito!"
                percentLabel.Text = "100%"
                progressBar.Size = UDim2.new(1, 0, 1, 0)
                task.wait(0.8)
            else
                -- Si te pegan o se interrumpe, se reinicia el contador de forma limpia
                titleLabel.Text = "Interrumpido / Buscando..."
                percentLabel.Text = "0%"
                progressBar.Size = UDim2.new(0, 0, 1, 0)
                task.wait(0.3)
            end
        else
            titleLabel.Text = "Buscando Brainrot para robar..."
            percentLabel.Text = "0%"
            progressBar.Size = UDim2.new(0, 0, 1, 0)
        end
        
        task.wait(0.2)
    end
end)
