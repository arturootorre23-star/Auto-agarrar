-- Función de escaneo avanzada para encontrar prompts con acción "Robar"
local function getBestRobarPrompt()
    local closestPrompt = nil
    local shortestDistance = math.huge
    local character = LocalPlayer.Character
    
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = character.HumanoidRootPart.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            if string.lower(obj.ActionText) == "robar" then
                local parentPart = obj.Parent
                if parentPart and (parentPart:IsA("BasePart") or parentPart:IsA("Model")) then
                    local targetPos = parentPart:IsA("Model") and parentPart:GetPivot().Position or parentPart.Position
                    local dist = (rootPos - targetPos).Magnitude
                    
                    if dist < shortestDistance and dist <= (obj.MaxActivationDistance + 15) then
                        shortestDistance = dist
                        closestPrompt = obj
                    end
                end
            end
        end
    end
    return closestPrompt
end

-- Bucle principal del auto-robado sincronizado con la interfaz
task.spawn(function()
    local progressValue = 0
    
    while true do
        local targetPrompt = getBestRobarPrompt()
        
        if targetPrompt then
            -- Intentamos extraer el nombre real del objeto desde la jerarquía del ProximityPrompt
            local parentName = "Brainrot"
            if targetPrompt.Parent and targetPrompt.Parent.Parent then
                parentName = targetPrompt.Parent.Parent.Name
            end
            
            TitleLabel.Text = parentName
            StatusLabel.Text = "Robando"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100) -- Verde de acción
            
            -- Incremento rápido y fluido hasta completar el 100% en menos de 1 segundo
            for i = 0, 100, 20 do
                progressValue = i
                ProgressBar.Size = UDim2.new(progressValue / 100, 0, 1, 0)
                task.wait(0.04)
            end
            
            -- Disparar instantáneamente la acción de robar de forma automática
            pcall(function()
                fireproximityprompt(targetPrompt)
            end)
            
            progressValue = 100
            ProgressBar.Size = UDim2.new(1, 0, 1, 0)
            StatusLabel.Text = "Paused"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 220, 0) -- Vuelve al amarillo de pausa del video
            
            task.wait(0.5)
        else
            -- Si no hay nada cerca, simula el estado de pausa / búsqueda pasiva del video
            TitleLabel.Text = "Buscando base..."
            StatusLabel.Text = "Paused"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 220, 0)
            
            progressValue = 0
            ProgressBar.Size = UDim2.new(0, 0, 1, 0)
            
            task.wait(0.2)
        end
    end
end)
