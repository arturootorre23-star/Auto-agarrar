-- 2. Función optimizada para buscar ProximityPrompts de tipo "Robar"
local function scanStealPrompt()
    local closestPrompt = nil
    local shortestDistance = math.huge
    local localCharacter = localPlayers.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return nil end
    local localRootPos = localCharacter.HumanoidRootPart.Position

    -- Escaneamos todo el Workspace de forma masiva buscando prompts
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            -- Validamos que el texto de la acción sea exactamente "Robar" (ignorando mayúsculas/minúsculas por seguridad)
            if string.lower(obj.ActionText) == "robar" then
                local parentPart = obj.Parent
                if parentPart and (parentPart:IsA("BasePart") or parentPart:IsA("Model")) then
                    local targetPos = parentPart:IsA("Model") and parentPart:GetPivot().Position or parentPart.Position
                    local dist = (localRootPos - targetPos).Magnitude
                    
                    if dist < shortestDistance and dist <= (obj.MaxActivationDistance + 10) then
                        shortestDistance = dist
                        closestPrompt = obj
                    end
                end
            end
        end
    end
    return closestPrompt
end

-- 3. Bucle principal: Barra constante y autorrobo inmediato al detectar
task.spawn(function()
    local currentPercent = 0
    while true do
        local targetPrompt = scanStealPrompt()
        
        if targetPrompt then
            titleLabel.Text = "¡Brainrot detectado! Robando..."
            
            -- Si hay un prompt válido, forzamos la barra a completarse al 100% y disparamos de inmediato
            for i = currentPercent, 100, 10 do
                currentPercent = i
                percentLabel.Text = currentPercent .. "%"
                progressBar.Size = UDim2.new(currentPercent / 100, 0, 1, 0)
                task.wait(0.02)
            end
            
            -- Disparo automático instantáneo del "Robar"
            pcall(function()
                fireproximityprompt(targetPrompt)
            end)
            
            titleLabel.Text = "¡Robado con éxito!"
            percentLabel.Text = "100%"
            progressBar.Size = UDim2.new(1, 0, 1, 0)
            task.wait(0.5)
            
            currentPercent = 0
        else
            -- Si no hay nada cerca, la barra sube y baja constantemente de modo dinámico simulando actividad
            currentPercent = currentPercent + 5
            if currentPercent > 90 then
                currentPercent = 10 -- Se reinicia antes de llegar a 100 para indicar búsqueda activa
            end
            
            titleLabel.Text = "Buscando Brainrot para robar..."
            percentLabel.Text = currentPercent .. "%"
            progressBar.Size = UDim2.new(currentPercent / 100, 0, 1, 0)
            
            task.wait(0.1)
        end
    end
end)
