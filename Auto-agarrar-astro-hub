-- 2. Función para buscar el prompt de robo cercano
local function scanStealBrainrot()
    local closestPrompt, shortestDistance = nil, math.huge
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = character.HumanoidRootPart.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Name == "StealPrompt" then
            local model = obj.Parent
            while model and model ~= workspace and not model:GetAttribute("Brainrot") do
                model = model.Parent
            end
            
            if model and model:GetAttribute("Brainrot") == true then
                local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                if primary then
                    local dist = (primary.Position - rootPos).Magnitude
                    if dist < shortestDistance and dist <= 15 then
                        shortestDistance = dist
                        closestPrompt = obj
                    end
                end
            end
        end
    end
    return closestPrompt
end

-- 3. Bucle principal para animar la barra y ejecutar el robo
task.spawn(function()
    while true do
        local targetPrompt = scanStealBrainrot()
        
        if targetPrompt then
            pcall(function()
                targetPrompt.HoldDuration = 0
            end)

            -- Anima la barra fluidamente del 0% al 100% en menos de 1 segundo
            local interrupted = false
            for i = 1, 100, 10 do
                if not targetPrompt or not targetPrompt.Parent then
                    interrupted = true
                    break
                end
                
                percentLabel.Text = i .. "%"
                progressBar.Size = UDim2.new(i / 100, 0, 1, 0)
                task.wait(0.015)
            end

            percentLabel.Text = "100%"
            progressBar.Size = UDim2.new(1, 0, 1, 0)

            if not interrupted then
                pcall(function()
                    fireproximityprompt(targetPrompt)
                end)
            end

            task.wait(0.5)
        else
            progressBar.Size = UDim2.new(0, 0, 1, 0)
            percentLabel.Text = "0%"
        end

        task.wait(0.2)
    end
end)
