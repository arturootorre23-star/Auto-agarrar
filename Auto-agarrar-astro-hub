-- 2. Función estricta para buscar únicamente Prompts de ROBO de Brainrots
local function scanStealPrompt()
    local closestPrompt, shortestDistance = nil, math.huge
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = character.HumanoidRootPart.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            -- Verificamos estrictamente que sea una acción de robar y no de compra o base
            local actionText = string.lower(obj.ActionText or "")
            local promptName = string.lower(obj.Name or "")
            
            if actionText:find("robar") or promptName:find("steal") then
                local model = obj.Parent
                while model and model ~= workspace and not model:GetAttribute("Brainrot") do
                    model = model.Parent
                end
                
                -- Si pertenece a un Brainrot válido
                if model and model:GetAttribute("Brainrot") == true then
                    local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local dist = (primary.Position - rootPos).Magnitude
                        if dist < shortestDistance and dist <= 15 then
                            shortestDistance = dist
                            closestPrompt = obj
                        end
                    end
                end
            end
        end
    end
    return closestPrompt
end

-- 3. Bucle principal con temporizador sincronizado a 3 segundos exactos para robar
task.spawn(function()
    while true do
        local targetPrompt = scanStealPrompt()
        
        if targetPrompt then
            -- Configuramos una duración de 3 segundos para el prompt para que coincida con la barra
            pcall(function()
                targetPrompt.HoldDuration = 3
            end)

            -- Barra sincronizada: sube del 0% al 100% de manera fluida exactamente en 3 segundos
            local interrupted = false
            for i = 1, 100, 1 do
                if not targetPrompt or not targetPrompt.Parent then
                    interrupted = true
                    break
                end
                
                percentLabel.Text = i .. "%"
                progressBar.Size = UDim2.new(i / 100, 0, 1, 0)
                -- 3 segundos totales divididos en 100 pasos = 0.03 segundos por paso
                task.wait(0.03)
            end

            percentLabel.Text = "100%"
            progressBar.Size = UDim2.new(1, 0, 1, 0)

            -- Al completarse los 3 segundos, se ejecuta el auto-robo
            if not interrupted then
                pcall(function()
                    fireproximityprompt(targetPrompt)
                end)
            end

            task.wait(0.5)
        else
            progressBar.Size = UDim2.new(0, 0, 1, 0)
            percentLabel.Text = "0%"
        end

        task.wait(0.2)
    end
end)
